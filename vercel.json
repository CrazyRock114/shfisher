{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30,
        "includeFiles": "server/**, data/fishing_spots.json, web/**"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }]
}
